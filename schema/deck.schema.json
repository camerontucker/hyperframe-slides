{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/camerontucker/hyperframe-slides/blob/main/schema/deck.schema.json",
  "title": "HyperFrames Slides deck",
  "description": "Portable embedded deck JSON v1 emitted by deck get and deck snapshot. Run deck validate for presentation limits and embedded asset checks; local file-backed source uses storage.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "theme", "slides", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "theme": {"enum": ["midnight", "paper", "cobalt", "sunset", "regent"]},
    "template": {"$ref": "#/$defs/template"},
    "slides": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/slide"}},
    "updatedAt": {"type": "integer", "minimum": 0, "description": "Unix seconds; the app refreshes this on save."}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,80}$"},
    "imageData": {"type": "string", "pattern": "^data:image/(png|jpeg|gif|webp);base64,"},
    "fontData": {"type": "string", "pattern": "^data:font/woff2;base64,"},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": {"type": "string", "maxLength": 500},
        "footer": {"type": "string", "maxLength": 500},
        "logo": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/imageData"}]},
        "showOutline": {"type": "boolean"},
        "headingFont": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fontData"}]},
        "bodyFont": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fontData"}]}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layout", "eyebrow", "title", "body", "notes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "layout": {"enum": ["title", "statement", "split", "quote", "contrast", "quiz"]},
        "eyebrow": {"type": "string", "maxLength": 10000},
        "outlineGroup": {"type": "string", "maxLength": 80, "description": "Major outline heading shared by adjacent slides. When omitted, the app uses the first part of the eyebrow."},
        "title": {"type": "string", "maxLength": 10000},
        "body": {"type": "string", "maxLength": 10000, "description": "Markdown supporting text."},
        "notes": {"type": "string", "maxLength": 10000},
        "revealOptions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 160}, "description": "Choices shown one at a time on successive Next presses."},
        "revealBullets": {"type": "boolean", "default": false, "description": "Fade in top-level body list items on successive Next presses."},
        "soundEffect": {"enum": ["none", "modem"], "default": "none", "description": "Sound played once on slide entry; stops when navigating away."},
        "animation": {"enum": ["none", "fade", "rise", "zoom"], "default": "rise"},
        "images": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/image"}}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alt", "dataUri", "x", "y", "width", "height"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "alt": {"type": "string", "maxLength": 500},
        "dataUri": {"$ref": "#/$defs/imageData"},
        "background": {"type": "boolean", "default": false},
        "x": {"type": "number", "minimum": 0, "maximum": 100},
        "y": {"type": "number", "minimum": 0, "maximum": 100},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
      }
    }
  }
}
